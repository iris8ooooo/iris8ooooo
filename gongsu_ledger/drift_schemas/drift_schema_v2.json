          "sql": "CREATE TABLE IF NOT EXISTS \"day_memos\" (\"date_key\" INTEGER NOT NULL, \"body\" TEXT NOT NULL, \"updated_at_millis\" INTEGER NOT NULL, PRIMARY KEY (\"date_key\"));"
