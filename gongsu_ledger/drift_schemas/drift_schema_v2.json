    {
      "name": "work_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"work_entries\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"uid\" TEXT NOT NULL UNIQUE, \"date_key\" INTEGER NOT NULL, \"centi_gongsu\" INTEGER NOT NULL, \"preset_id\" INTEGER NULL, \"label_snapshot\" TEXT NOT NULL DEFAULT '', \"color_id_snapshot\" INTEGER NOT NULL DEFAULT 0, \"site_id\" INTEGER NULL, \"unit_rate_won_override\" INTEGER NULL, \"created_at_millis\" INTEGER NOT NULL, \"updated_at_millis\" INTEGER NOT NULL, \"deleted_at_millis\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "presets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"presets\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"uid\" TEXT NOT NULL UNIQUE, \"name\" TEXT NOT NULL, \"centi_gongsu\" INTEGER NOT NULL, \"color_id\" INTEGER NOT NULL DEFAULT 0, \"sort_order\" INTEGER NOT NULL, \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)), \"created_at_millis\" INTEGER NOT NULL, \"updated_at_millis\" INTEGER NOT NULL);"
        }
      ]
    },
    {
